{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Annotator",
  "identifier": "com.universal-annotator.app",
  "version": "1.0.0",
  "build": {
    "frontendDist": "../dist/public",
    "devUrl": "http://localhost:25410/tauri-annotator/"
  },
  "app": {
    "withGlobalTauri": false,
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "Universal Annotator"
    },
    "windows": [
      {
        "label": "popup",
        "title": "Universal Annotator",
        "width": 540,
        "height": 480,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "focus": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2025 Universal Annotator",
    "category": "Utility",
    "shortDescription": "Global annotation popup — capture notes from any window instantly",
    "longDescription": "Universal Annotator gives you a global Spotlight-style popup (Ctrl+Shift+L) to capture notes, highlights, drawings, and links from any window. Supports native OS file tagging (Finder tags on macOS, System.Keywords on Windows, user.xdg.tags on Linux).",
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": "./entitlements.plist",
      "signingIdentity": null,
      "providerShortName": null,
      "frameworks": []
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "oneclick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libxdo3"
        ]
      }
    }
  }
}
