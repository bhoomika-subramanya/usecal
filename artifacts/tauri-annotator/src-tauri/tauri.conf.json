{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Annotator",
  "identifier": "com.universal-annotator.app",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:25410/tauri-annotator/"
  },
  "app": {
    "withGlobalTauri": false,
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "Universal Annotator"
    },
    "windows": [
      {
        "label": "popup",
        "title": "Universal Annotator",
        "width": 540,
        "height": 480,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "focus": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
